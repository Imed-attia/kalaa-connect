# ==============================================================
# Kalaa Connect — Configuration d'environnement (Variables d'exemple)
# Respect strict de la règle : aucun secret dans le code source
# ==============================================================

# API Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Base de données & Supabase (Palier Gratuit)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Mode Base de Données : "supabase" ou "mock" (le mode mock permet l'exécution 100% autonome hors-ligne)
DATABASE_MODE=mock

# Intelligence Artificielle (Semaine 7 - Bonus)
# Clé API Google Gemini (Gratuit avec quotas)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
AI_CONFIDENCE_THRESHOLD=0.65

# Notifications Emails (Brevo ou Resend)
EMAIL_PROVIDER=mock
RESEND_API_KEY=re_example_api_key
BREVO_API_KEY=xkeysib-example_api_key
EMAIL_FROM=notifications@kalaa-connect.tn

# Stockage d'images (limite 1 Mo, JPEG/PNG/WebP sans EXIF)
UPLOAD_STORAGE_BUCKET=signalements-photos
MAX_FILE_SIZE_BYTES=1048576

# Supervision & Observabilité (Grafana Cloud / Prometheus)
METRICS_ENABLED=true
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
GRAFANA_USER=your-user-id
GRAFANA_API_KEY=your-grafana-key
